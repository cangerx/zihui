APP_NAME=AgentAdmin
APP_ENV=local
APP_KEY=
APP_DEBUG=true
# 站点对外访问地址：务必改成你的真实域名（如 https://your-domain.com）。
# 影响图标 / 封面等绝对 URL 拼接。独立部署若保持默认 http://localhost，
# 系统会自动回退用当前请求域名兜底，但仍强烈建议显式配置为真实对外域名。
APP_URL=http://localhost

LOG_CHANNEL=stack
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=your_database
DB_USERNAME=your_db_user
DB_PASSWORD=your_db_password

CACHE_DRIVER=file
SESSION_DRIVER=file
SESSION_LIFETIME=120

# ==== Queue (异步图像任务) ====
# 默认 sync：升级零配置，GatewayController 用 terminating 在响应后跑任务（等同老行为）。
# 老部署升级时这一行可不动 / 不加。
#
# 想要真异步 + 失败重试 + failed_jobs 可观测，改为 database 并长驻 worker：
#   QUEUE_CONNECTION=database
#   php artisan migrate --force        # 建 jobs / failed_jobs 表
#   php artisan queue:work database --queue=image,default --tries=2 --timeout=960 --sleep=2
# 建议用 supervisor / NSSM / systemd 守护，崩溃自动拉起。
# 不变量：worker --timeout(960s) > 单次 image timeout(900s)，确保慢任务不被 worker 强切。
QUEUE_CONNECTION=sync

JWT_SECRET=
JWT_TTL=1440
JWT_REFRESH_TTL=20160


# ==== CloudBuild (talks to agent-build) ====
# auto: APP_ENV=local/testing 走本地执行账本；production 默认仍走授权端。显式 local/remote 可覆盖。
# 生产切换请保持 auto，用 php artisan cloud-build:cutover switch-backend --backend=local|remote 写 override。
# 显式 CLOUDBUILD_BACKEND=local|remote 会锁死命令切换。状态文件不含凭据。
CLOUDBUILD_BACKEND=auto
# 默认指向官方打包平台，自建镜像才需要改 AGENT_BUILD_BASE_URL
AGENT_BUILD_BASE_URL=https://your-build-domain.example.com
AGENT_BUILD_TIMEOUT=15
CLOUDBUILD_DOWNLOAD_TIMEOUT=1800

# ==== 在线更新（短期走授权端；后续 COS 只改 zip 地址并加 UPDATE_ALLOWED_ZIP_HOSTS）====
# 留空则使用 {AGENT_BUILD_BASE_URL}/api/updates/admin/version.json
UPDATE_CHECK_URL=
UPDATE_RELEASES_URL=
# UPDATE_ALLOWED_ZIP_HOSTS=your-bucket.cos.ap-xxx.myqcloud.com

# ==== CloudBuild 本地执行（T4.2，与授权端并行；未填则 dispatch 跳过）====
# 值从本机/服务器环境注入，不要把真实 token 提交进仓库。
GITHUB_BUILD_TOKEN=
GITHUB_BUILD_REPO=
GITHUB_BUILD_REF=main
GITHUB_WORKFLOW_WIN=build-win.yml
GITHUB_WORKFLOW_MAC=build-mac.yml
GITHUB_BUILD_VERIFY_SSL=true
# CLOUDBUILD_GITHUB_CALLBACK_URL=https://your-admin-domain.example.com/api/cloud-build/callback
# BUILD_QUEUE_MAX_DEPTH=100
# BUILD_SIGN_SECRET=
# BUILD_DOWNLOAD_TTL=1800
# CLOUDBUILD_MIRROR_WORKER_TOKEN=

# ==== 云端知识库（Qdrant 向量库）====
# Qdrant 连接（地址 / API Key / collection）在管理后台「知识库管理 → 知识库设置」配置，
# 不在此 .env 配置。部署 Qdrant：
#   docker run -d -p 6333:6333 -v /data/qdrant:/qdrant/storage qdrant/qdrant
# 知识库文档索引建议走异步队列（与图像任务共用 database 驱动）：
#   QUEUE_CONNECTION=database
#   php artisan queue:work database --queue=kb-index,image,default --tries=2 --timeout=300 --sleep=2

# ==== AI 抠图限流（可选）====
# AccessKey / endpoint / 单次扣费等不在这里配置，全部由管理后台「AI 抠图 → 自定义设置」管理
# 仅以下两项是性能调优开关，对接阿里云 viapi 默认值即可，一般不需要改：
#   - ALIYUN_MATTING_GLOBAL_QPS：全站每秒最多发起多少抠图请求（默认 5）
#   - ALIYUN_MATTING_PER_USER_CONCURRENCY：单用户同时进行的抠图任务数（默认 3）
# ALIYUN_MATTING_GLOBAL_QPS=5
# ALIYUN_MATTING_PER_USER_CONCURRENCY=3

# ==== Skill Catalog（从授权端增量同步；值为空则 sync 跳过）====
# 不要提交真实 token / 公钥。生产启用前至少填 BASE_URL、SYNC_TOKEN、KEY_ID、公钥和 TICKET_SECRET。
# TICKET_SECRET 与授权端 SKILL_REGISTRY_TICKET_SECRET 独立，只保护云控下发给桌面的短时下载票。
SKILL_REGISTRY_BASE_URL=
SKILL_REGISTRY_SYNC_TOKEN=
SKILL_REGISTRY_KEY_ID=
SKILL_REGISTRY_ED25519_PUBLIC=
SKILL_REGISTRY_OLD_KEY_ID=
SKILL_REGISTRY_ED25519_OLD_PUBLIC=
SKILL_CATALOG_TICKET_SECRET=
# SKILL_CATALOG_TICKET_TTL=300
# SKILL_CATALOG_DOWNLOAD_BASE=/api/client/skills/download

