# ==========================================
# agent-admin .gitignore
# ==========================================

# === Composer / Laravel backend ===
/backend/vendor/
/backend/.env
/backend/.env.backup
/backend/.env.production
/backend/.env.prod.bak
/backend/storage/*.key
/backend/storage/app/private/
/backend/storage/framework/cache/data/*
/backend/storage/framework/sessions/*
/backend/storage/framework/testing/*
/backend/storage/framework/views/*
/backend/storage/logs/*
# install.php 写入的安装锁，仅运行时存在
/backend/storage/installed.lock
!/backend/storage/framework/cache/data/.gitkeep
!/backend/storage/framework/sessions/.gitkeep
!/backend/storage/framework/testing/.gitkeep
!/backend/storage/framework/views/.gitkeep
!/backend/storage/logs/.gitkeep
/backend/public/storage
/backend/public/hot
/backend/public/build/
/backend/public/admin/
/backend/public/docs/
/backend/public/updates/
# Cloud-build icon uploads (user-provided PNGs, managed at runtime by
# CloudBuildIconController; directory auto-created on first upload)
/backend/public/cloud-build/
/backend/Homestead.json
/backend/Homestead.yaml
/backend/auth.json
/backend/.phpunit.result.cache
/backend/.phpunit.cache/

# === Frontend (Vite + React) ===
/frontend/node_modules/
/frontend/dist/
/frontend/dist-ssr/
/frontend/.env
/frontend/.env.*
!/frontend/.env.example
/frontend/*.local
/frontend/.vite/

# === Logs ===
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# === Editor / IDE ===
.vscode/*
!.vscode/extensions.json
.idea/
*.swp
*.swo
*~

# === OS ===
.DS_Store
Thumbs.db
desktop.ini

# === Misc ===
*.suo
*.ntvs*
*.njsproj
*.sln
composer.phar
*.tsbuildinfo

# === Local working scratch ===
check.txt
disabled.txt
