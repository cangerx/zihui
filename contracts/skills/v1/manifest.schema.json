{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local-agent.example/contracts/skills/v1/manifest.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "skill_id", "version_id", "slug", "name", "version", "entrypoint", "files", "permissions", "minimum_client_version"],
  "properties": {
    "schema_version": { "const": 1 },
    "skill_id": { "type": "string", "format": "uuid" },
    "version_id": { "type": "string", "format": "uuid" },
    "slug": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$", "maxLength": 120 },
    "name": { "type": "string", "minLength": 1, "maxLength": 120 },
    "description": { "type": "string", "maxLength": 1000 },
    "version": { "type": "string", "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-[0-9A-Za-z.-]+)?(?:\\+[0-9A-Za-z.-]+)?$" },
    "entrypoint": { "const": "SKILL.md" },
    "files": { "type": "array", "minItems": 2, "uniqueItems": true, "items": { "type": "string", "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\).+$" } },
    "permissions": {
      "type": "object",
      "additionalProperties": false,
      "required": ["filesystem", "network", "commands", "mcp_servers", "external_programs"],
      "properties": {
        "filesystem": { "enum": ["none", "workspace_read", "workspace_write"] },
        "network": { "type": "object", "additionalProperties": false, "required": ["domains"], "properties": { "domains": { "type": "array", "uniqueItems": true, "items": { "type": "string", "pattern": "^(?:[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?\\.)+[a-z]{2,63}$" } } } },
        "commands": { "type": "array", "uniqueItems": true, "items": { "type": "string", "pattern": "^[A-Za-z0-9._+-]+$" } },
        "mcp_servers": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1, "maxLength": 120 } },
        "external_programs": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1, "maxLength": 120 } }
      }
    },
    "minimum_client_version": { "type": "string", "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$" }
  }
}

